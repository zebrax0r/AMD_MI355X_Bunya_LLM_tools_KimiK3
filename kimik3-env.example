# Configuration for serve-kimik3.sh on Bunya's MI355X — copy to kimik3.env and edit.
#
#   cp kimik3-env.example kimik3.env
#
# Every value uses the ${VAR:-default} form, so anything you export in your
# shell (or in an sbatch --export) takes precedence over this file.
# kimik3.env contains your HF token — keep it out of git (see .gitignore).
#
# The defaults reproduce SGLang's validated day-0 8x MI355X TP8 recipe
# (sgl-project/sglang issue #32548). Change them from measurement, not by guess.

# ── Required ────────────────────────────────────────────────────────────────

# Scratch path for the HuggingFace cache, the .sif, the API key, and the server
# log/PID. Point this at /scratch (NOT /home — tight quota) and make sure it is
# visible from the compute node.
#
#   Kimi-K3 weights   1561 GB (measured from its safetensors index)
#   container .sif     ~30 GB
#   DSpark draft       (only if SPECULATIVE=dspark)
#   -> plan for ~1.7 TB free.  Check with 'rquota' and 'df -h'.
#
export MODEL_CACHE_DIR="${MODEL_CACHE_DIR:-}"
# e.g. export MODEL_CACHE_DIR="${MODEL_CACHE_DIR:-/scratch/user/$USER/kimik3/hf-cache}"

# HuggingFace token, needed for the first weights download.
# Either set the token directly ...
export HF_TOKEN="${HF_TOKEN:-}"
# ... or point at a file containing only the token (safer for shared configs):
export HF_TOKEN_FILE="${HF_TOKEN_FILE:-}"

# ── Model ───────────────────────────────────────────────────────────────────

# The official weights are already MXFP4-native ("mxfp4-pack-quantized" in
# config.json), so there is no AMD requant to wait for — this repo serves
# Moonshot's release directly.
export MODEL_ID="${MODEL_ID:-moonshotai/Kimi-K3}"

# The name clients put in the OpenAI "model" field.
export SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-kimi-k3}"

# ── Container image ─────────────────────────────────────────────────────────

# SGLang's day-0 AMD image for Kimi K3 on gfx950 (issue #32548).
#
# NOTE: this is built from the unmerged 'kimi-k3' branch (PR #32541), not from
# main. It is pinned to a dated tag on purpose. Once that PR merges, move to a
# mainline lmsysorg/sglang-rocm:*-mi35x-* tag and re-verify with
# './serve-kimik3.sh check'. See the README "When the branch merges".
#
# The image ships its OWN ROCm (7.2 in this tag). It does not have to match the
# node's, but the further apart they drift the more likely GPU passthrough
# breaks — see ROCM_MODE below and './serve-kimik3.sh gpucheck'. After changing
# this value the aiter JIT dir re-seeds itself automatically.
export SGLANG_IMAGE="${SGLANG_IMAGE:-docker://lmsysorg/sglang-rocm:rocm720-mi35x-k3-20260727}"

# Path to the Apptainer image FILE (built with './serve-kimik3.sh pull').
# Must be a .sif file, not a directory. Defaults to
# $MODEL_CACHE_DIR/kimik3-mi355x.sif.
export SIF_PATH="${SIF_PATH:-}"

# Apptainer cache/scratch. Keep these OFF /home (quota) — on scratch. Default is
# alongside MODEL_CACHE_DIR if left empty.
export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-}"
export APPTAINER_TMPDIR="${APPTAINER_TMPDIR:-}"

# The MXFP4 MoE JIT-compiles FlyDSL kernels into aiter's jit/ directory INSIDE
# the image, which is read-only in a .sif — so capture dies with "[Errno 30]
# Read-only file system: .../aiter/jit/flydsl_cache/...", and it dies only
# after the full 1.5 TB weight load. serve-kimik3.sh seeds this scratch dir
# from the image's jit/ (once, to keep the prebuilt module_*.so) and binds it
# back over the same path, so writes succeed and compiled kernels persist
# across runs. Defaults to $MODEL_CACHE_DIR/aiter-jit.
#
# The seed marker records which image it came from, so changing SGLANG_IMAGE
# re-seeds automatically — a stale copy from an older image is otherwise a good
# way to get undefined-symbol crashes at graph capture. Deleting the directory
# by hand also works.
export AITER_JIT_DIR="${AITER_JIT_DIR:-}"
# In-image jit/ path. Auto-detected; set only if detection picks the wrong one
# (it warns loudly when it cannot find aiter at all).
export AITER_JIT_TARGET="${AITER_JIT_TARGET:-}"

# ── Endpoint auth ───────────────────────────────────────────────────────────

# API key for the endpoint (clients send "Authorization: Bearer ..."). Leave
# empty to have serve-kimik3.sh generate one and persist it to
# ${MODEL_CACHE_DIR}/kimik3-api-key so it stays stable across jobs.
#
# This is one of our deliberate deviations from upstream: their recipe binds to
# 127.0.0.1 and needs no auth, but we bind 0.0.0.0 so tunnels and off-node
# opencode work — so the key is the only thing gating the port.
export KIMIK3_API_KEY="${KIMIK3_API_KEY:-}"

# ── Serving parameters (upstream recipe) ────────────────────────────────────

export PORT="${PORT:-30000}"

# An MI355X node has 8 GPUs and --tp IS the total GPU count. Upstream's
# published numbers are all TP8 on one node.
export TP_SIZE="${TP_SIZE:-8}"

# dp-attention groups. Upstream does not use it; DP_SIZE must divide TP_SIZE.
export DP_SIZE="${DP_SIZE:-1}"

# Max context. EMPTY = the model's own maximum (1,048,576), which is what the
# upstream recipe does — it passes no --context-length at all.
#
# If KV-cache allocation fails at startup, set this to 262144 FIRST (before
# touching MEM_FRACTION) so you learn which knob mattered.
export CONTEXT_LEN="${CONTEXT_LEN:-}"

# --mem-fraction-static. 0.85 is upstream's validated value:
#   weights 1561 GB / 2304 GB HBM = 68%; 0.85 leaves ~397 GB for KV + graphs.
export MEM_FRACTION="${MEM_FRACTION:-0.85}"

# --attention-backend. triton is what upstream validated for K3's hybrid
# KDA + MLA attention on gfx950.
export ATTENTION_BACKEND="${ATTENTION_BACKEND:-triton}"

# --dtype. The weights are MXFP4; this is the compute/activation dtype.
export MODEL_DTYPE="${MODEL_DTYPE:-bfloat16}"

# --cuda-graph-max-bs-decode. NOTE the name: the old --cuda-graph-max-bs no
# longer exists on this branch. Raise for more decode concurrency (costs
# memory), lower if graph capture OOMs.
export CUDA_GRAPH_MAX_BS_DECODE="${CUDA_GRAPH_MAX_BS_DECODE:-256}"

# --disable-radix-cache. Upstream sets this (1); we default to 0 (caching ON)
# because we measured it, 29 Jul 2026 on bun161 with DSpark:
#
#   c    total tok/s        median TPOT        median TTFT
#   2    918 -> 964         5.61 -> 5.35 ms    253 -> 255 ms
#   8    2074 -> 2299       10.13 -> 9.10 ms   299 -> 288 ms
#   32   3793 -> 4608       21.85 -> 14.04 ms  663 -> 1877 ms
#
# Better on throughput and per-token latency everywhere. The one cost is TTFT
# at c=32 (P99 2383 -> 7998 ms) — the scheduler batches harder, so end-to-end
# latency still improves (11.8 -> 9.3 s). Set back to 1 if you serve many
# interactive users at once and first-token latency matters more than total
# throughput.
#
# Note this measurement UNDERSTATES the gain for opencode: the benchmark uses
# random prompts that share no prefixes, so it never exercises prefix reuse at
# all. opencode resends a near-identical context every turn.
export DISABLE_RADIX_CACHE="${DISABLE_RADIX_CACHE:-0}"

# KV cache dtype. Upstream passes none, so this is empty by default. Set e.g.
# fp8_e4m3 only if you have benched it and it helps.
export KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-}"

# ── Parsers (tool calling + thinking) ───────────────────────────────────────

# K3 ships its own parsers (KimiK3Detector on the branch) — NOT kimi_k2.
# opencode's agentic loop depends on the tool-call parser being right.
# List what your image actually supports with:  ./serve-kimik3.sh parsers
# Set to "none" to pass no parser flag at all.
export TOOL_PARSER="${TOOL_PARSER:-kimi_k3}"
export REASONING_PARSER="${REASONING_PARSER:-kimi_k3}"

# ── Speculative decoding (DSpark) ───────────────────────────────────────────

# Empty (default) = off.  "dspark" = enable DSpark speculative decoding.
#
# Upstream's MI355 TP8 numbers make this very attractive for interactive use:
#   concurrency 2:  median TPOT 20.86 ms -> 8.94 ms, 820 -> 1659 tok/s
#   accept length ~5.3-5.9 tokens per step
#
# Default OFF because SGLang issue #32569 reports DSPARK crashing
# ("TypeError: 'NoneType' object is not callable"). Get baseline serving working
# first, then turn this on — that way a failure has one cause, not two.
export SPECULATIVE="${SPECULATIVE:-}"
export DSPARK_MODEL="${DSPARK_MODEL:-RadixArk/Kimi-K3-DSpark}"

# ── ROCm / AMD kernel toggles ───────────────────────────────────────────────

# How the container reaches the GPUs.
#
#   auto     (default) probe 'rocm', then 'devices', and use the first that
#            actually sees the GPUs. The answer is cached per node+image in
#            $MODEL_CACHE_DIR/.rocm-mode; delete that file to re-probe.
#   rocm     apptainer --rocm. Binds the NODE's ROCm libraries into the
#            container and puts them first on LD_LIBRARY_PATH.
#   devices  no --rocm; bind /dev/kfd and /dev/dri only, so the container uses
#            its own ROCm end to end.
#
# Why this exists: on 28 Jul 2026 RCC moved a node to ROCm 7.14 while the image
# still shipped 7.2. With --rocm, the container's own /opt/rocm-7.2.0/bin/rocminfo
# started exiting 1 against the node's 7.14 libraries, and aiter died on import
# with "Get GPU arch from rocminfo failed". 'devices' avoids that mixing.
#
# Run './serve-kimik3.sh gpucheck' (about a minute) to see the per-mode result.
export ROCM_MODE="${ROCM_MODE:-auto}"

# Tells aiter the GPU architecture directly (as GPU_ARCHS), so it can skip its
# rocminfo shell-out. NOTE: the rocm720-mi35x-k3-20260727 build of aiter does
# NOT honour this at runtime — tested on bun161, 28 Jul 2026 — so it is kept
# only for images that might. Use ROCMINFO_SHIM below instead.
# Must name exactly ONE arch: a list makes aiter pick the first entry at
# runtime regardless of the hardware (ROCm/aiter#3807). Empty = leave alone.
export AITER_GPU_ARCHS="${AITER_GPU_ARCHS:-}"   # e.g. gfx950

# aiter reads the GPU architecture by running the image's rocminfo and parsing
# its text. On a node whose ROCm is newer than the image's, that binary fails
#   ROCk module version 6.19.14.31400000 is loaded
#   hsa api call failure ... HSA_STATUS_ERROR_INVALID_ARGUMENT
# even though torch sees all 8 GPUs (PyTorch's wheel bundles its own HIP
# runtime). So the image's ROCm *tools* break while its *runtime* is fine.
#
# The shim snapshots the HOST's working rocminfo output and binds a one-line
# script that replays it over the container's binary. Real output for this
# node, so whatever aiter's parser expects it gets; nothing links against it.
#
#   auto  (default) shim only when the container's own rocminfo fails
#   off   never
#   force always (use if detection says it works but aiter still can't read it)
export ROCMINFO_SHIM="${ROCMINFO_SHIM:-auto}"

# aiter is AMD's fused kernel library and is where the gfx950 FP4 MoE speed
# comes from. With 1 (default) serve-kimik3.sh exports upstream's four K3
# variables into the container:
#   SGLANG_USE_AITER=1  SGLANG_AITER_K3_OPT=1
#   AITER_FLYDSL_FORCE=1  AITER_SITUV2_A8W4=1
# Set to 0 to drop all four if aiter is the thing crashing.
export ENABLE_AITER="${ENABLE_AITER:-1}"

# AITER_FLYDSL_FORCE routes gemms through the FlyDSL JIT compiler, which writes
# into aiter/jit inside the read-only .sif. Set to 0 to use aiter's prebuilt
# gemm path instead: slower than upstream's numbers, but it compiles nothing,
# so it cannot hit the read-only-filesystem crash at CUDA-graph capture.
export FLYDSL_FORCE="${FLYDSL_FORCE:-1}"

# SGLang CPU-affinity pinning. The container image enables it, but it pins to
# CPUs from the full node topology and CRASHES under a SLURM cgroup that owns
# only a subset of cores ("CPU number N is not eligible"). Keep 0 unless you
# allocate the whole node's CPUs (e.g. --exclusive or --cpus-per-task=384).
# This one is ours, not upstream's — they have no cgroup to trip over.
export SET_CPU_AFFINITY="${SET_CPU_AFFINITY:-0}"

# Seconds to wait for the server to become healthy. A cold start reads ~1.5 TB
# off scratch and JIT-compiles FP4 kernels, so be generous.
export READY_TIMEOUT="${READY_TIMEOUT:-14400}"

# ── Escape hatches ──────────────────────────────────────────────────────────

# How the server is invoked inside the container. Upstream uses the 'sglang'
# CLI. The branch still ships launch_server.py, so if the CLI is missing or
# behaves oddly in your image, fall back to:
#   export LAUNCH_CMD="python3 -m sglang.launch_server"
export LAUNCH_CMD="${LAUNCH_CMD:-sglang serve}"

# Optional, all empty = upstream defaults. Measure every change with
# ./bench-kimik3.sh.
export CHUNKED_PREFILL_SIZE="${CHUNKED_PREFILL_SIZE:-}"   # lower if prefill OOMs
export MAX_RUNNING_REQUESTS="${MAX_RUNNING_REQUESTS:-}"   # lower if decode OOMs
export SCHEDULE_POLICY="${SCHEDULE_POLICY:-}"             # e.g. lpm (needs radix cache on)

# Extra flags appended verbatim to the launch command. Use this for anything
# version-specific rather than editing the script, e.g. expert parallelism:
#   export EXTRA_ENGINE_ARGS="--ep-size 8"
export EXTRA_ENGINE_ARGS="${EXTRA_ENGINE_ARGS:-}"

# ── Benchmark defaults (bench-kimik3.sh) ────────────────────────────────────
# Upstream MI355 TP8 reference: 820 / 2356 / 4898 tok/s at concurrency 2 / 8 / 32.

export BENCH_INPUT_LEN="${BENCH_INPUT_LEN:-1024}"
export BENCH_OUTPUT_LEN="${BENCH_OUTPUT_LEN:-512}"
export BENCH_NUM_PROMPTS="${BENCH_NUM_PROMPTS:-200}"
export BENCH_CONCURRENCY="${BENCH_CONCURRENCY:-2 8 32}"
export BENCH_MAX_CONCURRENCY="${BENCH_MAX_CONCURRENCY:-32}"
export BENCH_EXTRA_ARGS="${BENCH_EXTRA_ARGS:-}"
