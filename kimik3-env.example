# Copy to kimik3.env ONLY for a new installation. Do not overwrite a working config.
# All assignments, their order and empty/unset semantics match commit 406abdb.
# See docs/configuration.md for usage; docs/history/ for historical rationale.
# Most users only need to edit MODEL_CACHE_DIR and HF_TOKEN or HF_TOKEN_FILE.
# Keep tokens out of Git. Non-empty exported overrides survive ${VAR:-default}.

# Required local settings: absolute scratch path, then credentials.
export MODEL_CACHE_DIR="${MODEL_CACHE_DIR:-}"
export HF_TOKEN="${HF_TOKEN:-}"
export HF_TOKEN_FILE="${HF_TOKEN_FILE:-}"

# Model and container pins. An empty revision falls back to the pin, NOT main.
export MODEL_ID="${MODEL_ID:-moonshotai/Kimi-K3}"
export MODEL_REVISION="${MODEL_REVISION:-9f62e4e9fffbd0a83ddd60e1c209d828994b3569}"
export SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-kimi-k3}"
export SGLANG_IMAGE="${SGLANG_IMAGE:-docker://lmsysorg/sglang-rocm:v0.5.21-rocm724-mi35x-20261011}"
export SIF_PATH="${SIF_PATH:-}"
export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-}"
export APPTAINER_TMPDIR="${APPTAINER_TMPDIR:-}"
export SGLANG_CACHE_DIR="${SGLANG_CACHE_DIR:-}"
export AITER_JIT_DIR="${AITER_JIT_DIR:-}"
export AITER_JIT_TARGET="${AITER_JIT_TARGET:-}"
export AITER_CONFIG_DIR="${AITER_CONFIG_DIR:-}"

# API key: empty lets the launcher resolve/generate its persisted key.
export KIMIK3_API_KEY="${KIMIK3_API_KEY:-}"

# Baseline serving settings. Empty context leaves the engine/model limit unchanged.
export PORT="${PORT:-30000}"
export TP_SIZE="${TP_SIZE:-8}"
export DP_SIZE="${DP_SIZE:-1}"
export CONTEXT_LEN="${CONTEXT_LEN:-}"
export MEM_FRACTION="${MEM_FRACTION:-0.85}"
export ATTENTION_BACKEND="${ATTENTION_BACKEND:-triton}"
# Do not enable aiter prefill: cached-prefix corruption was reproduced on 13 Oct.
export PREFILL_ATTENTION_BACKEND="${PREFILL_ATTENTION_BACKEND-}"
export DECODE_ATTENTION_BACKEND="${DECODE_ATTENTION_BACKEND-}"
export MLA_DECODE_TUNE="${MLA_DECODE_TUNE:-1}"
export MODEL_DTYPE="${MODEL_DTYPE:-bfloat16}"
export CUDA_GRAPH_MAX_BS_DECODE="${CUDA_GRAPH_MAX_BS_DECODE:-256}"
export DISABLE_RADIX_CACHE="${DISABLE_RADIX_CACHE:-0}"
export KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-}"
export TOOL_PARSER="${TOOL_PARSER:-kimi_k3}"
export REASONING_PARSER="${REASONING_PARSER:-kimi_k3}"

# Experimental overrides. DSpark is OFF; keep the baseline for long sessions.
export SPECULATIVE="${SPECULATIVE-}"
export DSPARK_MODEL="${DSPARK_MODEL:-RadixArk/Kimi-K3-DSpark}"
export DSPARK_BLOCK_SIZE="${DSPARK_BLOCK_SIZE:-}"
export REPLAYSSM_SPEC="${REPLAYSSM_SPEC:-0}"
export MAMBA_FULL_MEMORY_RATIO="${MAMBA_FULL_MEMORY_RATIO:-}"
export MAMBA_SSM_DTYPE="${MAMBA_SSM_DTYPE:-}"
export MAMBA_RADIX_STRATEGY="${MAMBA_RADIX_STRATEGY:-}"
export MAMBA_SKIP_DECODE_LOCK="${MAMBA_SKIP_DECODE_LOCK:-0}"
export HSA_NO_SCRATCH_RECLAIM="${HSA_NO_SCRATCH_RECLAIM:-}"
export KDA_FUSED_DECODE="${KDA_FUSED_DECODE:-0}"

# Existing GPU compatibility, kernel and CPU-affinity controls.
export ROCM_MODE="${ROCM_MODE:-auto}"
export AITER_GPU_ARCHS="${AITER_GPU_ARCHS:-}"   # e.g. gfx950
export ROCMINFO_SHIM="${ROCMINFO_SHIM:-auto}"
export ENABLE_AITER="${ENABLE_AITER:-1}"
export FLYDSL_FORCE="${FLYDSL_FORCE:-1}"
export SET_CPU_AFFINITY="${SET_CPU_AFFINITY:-0}"
export READY_TIMEOUT="${READY_TIMEOUT:-14400}"

# Existing loader controls and draft pin. No cache or image migration is performed.
export WEIGHT_LOAD_THREADS="${WEIGHT_LOAD_THREADS:-8}"
export LOAD_FORMAT="${LOAD_FORMAT:-}"
export PRESHARDED_PATH="${PRESHARDED_PATH:-}"
export PREFETCH_BLOCK_SIZE_MB="${PREFETCH_BLOCK_SIZE_MB:-}"
export DSPARK_REVISION="${DSPARK_REVISION:-56ce616ad7486f0e96cbb51ef23ed5a1bce1d92d}"

# Existing escape hatches; leave empty unless deliberately testing a change.
export LAUNCH_CMD="${LAUNCH_CMD:-sglang serve}"
export CHUNKED_PREFILL_SIZE="${CHUNKED_PREFILL_SIZE:-}"   # lower if prefill OOMs
export MAX_RUNNING_REQUESTS="${MAX_RUNNING_REQUESTS:-}"   # lower if decode OOMs
export SCHEDULE_POLICY="${SCHEDULE_POLICY:-}"             # e.g. lpm (needs radix cache on)
export EXTRA_ENGINE_ARGS="${EXTRA_ENGINE_ARGS:-}"

# Benchmark defaults. The longcontext mode has its own shape-resolution logic.
export BENCH_INPUT_LEN="${BENCH_INPUT_LEN:-1024}"
export BENCH_OUTPUT_LEN="${BENCH_OUTPUT_LEN:-512}"
export BENCH_NUM_PROMPTS="${BENCH_NUM_PROMPTS:-200}"
export BENCH_CONCURRENCY="${BENCH_CONCURRENCY:-2 8 32}"
export BENCH_MAX_CONCURRENCY="${BENCH_MAX_CONCURRENCY:-32}"
export BENCH_EXTRA_ARGS="${BENCH_EXTRA_ARGS:-}"
